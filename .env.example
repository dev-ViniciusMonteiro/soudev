# Todas são opcionais. Configure em Vercel > Project > Settings > Environment Variables
# e faça um novo deploy depois de alterar (elas entram no build).

# Domínio final, sem barra no fim. Usado no sitemap, canonical e imagens de compartilhamento.
# Sem ela, usa o domínio de produção da Vercel automaticamente.
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Código de verificação do Google Search Console (método "Tag HTML", só o valor do content).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense: os anúncios só aparecem quando as duas estão preenchidas.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT=0000000000

# URL do Google Apps Script que recebe o formulário de contato (já tem um valor padrão no código).
GOOGLE_SCRIPT_URL=

# TMDB (The Movie Database) para o buscador de filmes e séries e o "onde assistir".
# Crie uma conta grátis em themoviedb.org, gere a chave em Configurações > API e cole o
# "API Read Access Token" (v4) em TMDB_BEARER. O TMDB_API_KEY (v3) é alternativa/fallback.
# Sem elas, a busca de livros funciona, mas filmes e séries mostram um aviso.
TMDB_BEARER=
TMDB_API_KEY=

# Buscador de eventos: chave grátis da Ticketmaster (developer.ticketmaster.com → crie um app
# e copie a "Consumer Key"). Sem ela, o buscador ainda funciona pelos atalhos (Sympla/Eventbrite/Google),
# mas não lista eventos dentro do site.
TICKETMASTER_KEY=

# Balão de ideias: URL do Cloudflare Worker que recebe as sugestões (pasta workers/ideias).
# Sem ela, o balão ainda aparece em modo demonstração, mas não grava nada.
NEXT_PUBLIC_IDEIAS_API=https://soudev-ideias.SEU-SUBDOMINIO.workers.dev
