{
  // Worker que recebe as ideias do balão do soudev e guarda no D1.
  // Painel admin seguro servido pelo próprio Worker em /admin.
  "name": "soudev-ideias",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",

  // Observabilidade (logs + traces) ligada para produção.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },

  // Banco D1. O código usa o binding "DB".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soudev-ideias",
      "database_id": "736fdd60-3347-4e2e-a322-6eda269875a1"
    }
  ],

  // Variáveis públicas (não são segredo). Os segredos (hash da senha e chave de sessão)
  // entram por `wrangler secret put`, nunca aqui.
  "vars": {
    "ADMIN_USER": "vinivn",
    "SESSAO_HORAS": "12",
    // URL do backend-soudev (super-admin dos sistemas). O token vai no secret ADMIN_SUPER_TOKEN.
    "SX_BACKEND_URL": "https://backend-soudev.backend-soudev.workers.dev"
  }
}
